{
  "name": "project-manager",
  "version": "1.0.0",
  "description": "项目开发进度管理工具",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json && node start-dev.js",
    "dev:renderer": "vite",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "test": "npm run test:pathguard && npm run test:ai-jobs && npm run test:auto-description && npm run test:navigation && npm run test:tasks",
    "test:pathguard": "npx tsx src/main/shared/__tests__/pathGuard.test.ts",
    "test:ai-jobs": "npx tsx --test src/renderer/stores/__tests__/aiJobStore.test.ts",
    "test:auto-description": "npx tsx --test src/renderer/utils/__tests__/autoProjectDescription.test.ts",
    "test:navigation": "npx tsx --test src/renderer/stores/__tests__/navigationStore.test.ts",
    "test:tasks": "npx tsx --test src/renderer/stores/__tests__/taskStore.test.ts",
    "verify": "npm run test && npm run typecheck && npm run build && echo ✅ All checks passed"
  },
  "dependencies": {
    "antd": "^5.22.0",
    "dayjs": "^1.11.13",
    "diff-match-patch": "^1.0.5",
    "docx": "^9.7.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.4.11",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
